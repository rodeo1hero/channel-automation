# Copy this file to .env for local runs (GitHub Actions uses repo secrets instead —
# see .github/workflows/publish.yml). Never commit the real .env file.

# Claude / Anthropic — used for idea generation, script writing, and metadata
ANTHROPIC_API_KEY=

# Google Cloud — used for Text-to-Speech AND the YouTube Data API
# (a single Google Cloud project can hold both, see SETUP_YOUTUBE_API.md)
GOOGLE_APPLICATION_CREDENTIALS_JSON=
# ^ paste the full contents of your service-account JSON key (for Cloud TTS) here as one line,
#   OR set GOOGLE_APPLICATION_CREDENTIALS to a file path instead when running locally.
GOOGLE_APPLICATION_CREDENTIALS=

# YouTube OAuth (generated once via scripts/get_youtube_refresh_token.py)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Image generation — Replicate (used for FLUX.2 [Pro])
REPLICATE_API_TOKEN=

# Optional: swap voice/image providers without touching code
TTS_PROVIDER=google        # google | elevenlabs
IMAGE_PROVIDER=replicate   # replicate | fal
